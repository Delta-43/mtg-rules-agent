# Copy to .env and fill in as needed. docker-compose reads this automatically.
# Everything here has a safe local-dev default (see docker-compose.yml) -- you only
# need this file to switch to hosted LLM mode, add auth, or restrict CORS.

# LLM provider: "local" (Ollama) or "hosted" (OpenRouter)
LLM_PROVIDER=local
# Only used when LLM_PROVIDER=local. Blank = server/project_config.yml's
# `models.llm` default (gemma4:cloud, an Ollama *cloud* model -- runs on
# Ollama's infrastructure, needs internet + a one-time `ollama signin`,
# despite LLM_PROVIDER=local). For genuinely offline/local inference, set
# this to a real local weights tag instead.
LLM_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=

# rules-mcp's embedding provider: "local" (Ollama, default) or "hosted"
# (OpenRouter). A separate key from OPENROUTER_API_KEY above on purpose --
# different container, different model, tracked independently on
# OpenRouter's side. Useful on slower/low-core hardware where local
# embedding compute (not request queueing) is the ingestion bottleneck.
EMBEDDING_PROVIDER=local
# Only used when EMBEDDING_PROVIDER=local. Blank = rules_mcp's own default
# (mxbai-embed-large). Independent of LLM_MODEL above -- rules-mcp is a
# separate, self-contained service with its own settings (see root
# CLAUDE.md), not read from project_config.yml at all.
EMBEDDING_MODEL=
OPENROUTER_EMBEDDING_API_KEY=
OPENROUTER_EMBEDDING_MODEL=

# Comma-separated X-API-Key values accepted by /chat and /chat/stream (empty =
# no valid keys configured, so no request has one -- everything runs as
# anonymous tier). A request with no X-API-Key header is always allowed
# through (anonymous tier); this list only validates keys that ARE presented.
API_KEYS=

# Comma-separated allowed origins for browser access (empty = CORS disabled)
CORS_ALLOWED_ORIGINS=

# Per-key/IP rate limit and daily request caps, tiered by whether the
# caller presented a valid API key. A cost ceiling against sustained abuse,
# not precise billing.
RATE_LIMIT_PER_MINUTE=20
DAILY_QUOTA_ANONYMOUS=30
DAILY_QUOTA_AUTHENTICATED=500

# Sent to Scryfall per their API guidelines -- identify your own deployment.
SCRYFALL_USER_AGENT=MTG-Judge-Chatbot/1.0 (+https://github.com/mtg-judge)
