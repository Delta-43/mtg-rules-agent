# Copy to .env and fill in as needed. docker-compose reads this automatically.
# Everything here has a safe local-dev default (see docker-compose.yml) -- you only
# need this file to switch to hosted LLM mode, add auth, or restrict CORS.

# LLM provider: "local" (Ollama) or "hosted" (OpenRouter)
LLM_PROVIDER=local
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=

# rules-mcp's embedding provider: "local" (Ollama, default) or "hosted"
# (OpenRouter). A separate key from OPENROUTER_API_KEY above on purpose --
# different container, different model, tracked independently on
# OpenRouter's side. Useful on slower/low-core hardware where local
# embedding compute (not request queueing) is the ingestion bottleneck.
EMBEDDING_PROVIDER=local
OPENROUTER_EMBEDDING_API_KEY=
OPENROUTER_EMBEDDING_MODEL=

# Comma-separated X-API-Key values accepted by /chat and /chat/stream (empty =
# no valid keys configured, so no request has one -- everything runs as
# anonymous tier). A request with no X-API-Key header is always allowed
# through (anonymous tier); this list only validates keys that ARE presented.
API_KEYS=

# Comma-separated allowed origins for browser access (empty = CORS disabled)
CORS_ALLOWED_ORIGINS=

# Per-key/IP rate limit and daily request caps, tiered by whether the
# caller presented a valid API key. A cost ceiling against sustained abuse,
# not precise billing.
RATE_LIMIT_PER_MINUTE=20
DAILY_QUOTA_ANONYMOUS=30
DAILY_QUOTA_AUTHENTICATED=500

# Sent to Scryfall per their API guidelines -- identify your own deployment.
SCRYFALL_USER_AGENT=MTG-Judge-Chatbot/1.0 (+https://github.com/mtg-judge)

# --- Optional: Cloudflare Tunnel (public deploy without opening a port) ---
# Only read if you start with `docker-compose --profile tunnel up`. Create
# the tunnel in the Cloudflare Zero Trust dashboard, point its public
# hostname at http://caddy:80, and paste its token here. See README's
# "Public deployment" section.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Optional: PWA build-time API base ---
# Leave empty for the default same-origin deploy (Caddy serves the PWA and
# proxies /chat*, /health on one domain). Only set this if the frontend is
# ever built to call a backend on a different origin.
VITE_API_BASE_URL=

# --- Optional: R2 backup (data/conversations.db + data/chroma -> Cloudflare R2) ---
# Only read if you start with `docker-compose --profile backup up`. Create an
# R2 bucket + API token (R2 > Manage API Tokens) in the Cloudflare dashboard.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_BACKUP_INTERVAL_SECONDS=3600

# --- Optional: Discord bot (discord_client/, `docker-compose --profile discord up`) ---
# Register an application in the Discord Developer Portal, add the
# applications.commands scope, and paste its token here.
DISCORD_BOT_TOKEN=
# A dedicated value also appended to API_KEYS above -- not shared with any
# other caller, so the bot's usage is tracked against its own daily quota.
DISCORD_API_KEY=
# Public URL the bot calls -- override only if the backend isn't at
# azor.delta43.net.
DISCORD_API_BASE_URL=https://azor.delta43.net
# Comma-separated guild IDs to restrict /judge to (empty = every server the
# bot is invited to).
DISCORD_ALLOWED_GUILD_IDS=
# Comma-separated channel IDs to restrict /judge to within an allowed guild
# (empty = every channel).
DISCORD_ALLOWED_CHANNEL_IDS=
# Per-user cooldown (seconds) on /judge, protecting the shared daily quota.
DISCORD_COOLDOWN_SECONDS=10

# --- Optional: accounts/tiers/billing pivot (see PLAN.md) ---
# Not read by any running request path yet -- Phase 0 scaffolding only.
# Everything here is safe to leave blank; the default ACCOUNTS_MODE=self_hosted
# means /chat behaves exactly as it does today regardless of what's set below.
ACCOUNTS_MODE=self_hosted
# Self-hosted Supabase, trimmed to Postgres + GoTrue (auth) only -- see
# accounts_db/README.md. Only read if you start with
# `docker-compose --profile accounts up`.
SUPABASE_DB_URL=
GOTRUE_URL=
GOTRUE_JWT_SECRET=
# OAuth provider credentials -- forwarded into the supabase-auth (GoTrue)
# container's own env block, not read by the main backend directly.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_DISCORD_CLIENT_ID=
OAUTH_DISCORD_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
# Postgres itself (the supabase-db container).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Stripe (premium subscriptions -- not wired up yet).
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PREMIUM=
# A plain Stripe Payment Link URL for a no-strings-attached donation button --
# independent of tiers/billing above, empty hides the button.
DONATION_LINK=
# Flat rolling-hour quota per tier, hosted mode only.
FREE_TIER_QUESTIONS_PER_HOUR=5
PREMIUM_TIER_QUESTIONS_PER_HOUR=20
