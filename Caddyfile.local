# Webapp-free counterpart to the root Caddyfile, used by the opt-in
# `caddy-local` compose service (bare `caddy:2` image, no build -- see
# docker-compose.yml). Forwards every path to mtg-judge, which already
# serves its own zero-build dev test UI at `/` (app_api/main.py's
# serve_index()) plus /chat, /chat/stream, /health, /metrics -- there's no
# static PWA bundle to serve here, so unlike the root Caddyfile there's no
# `root * /srv` / try_files / file_server block, and nothing to build.
#
# Same plain-`:80` reasoning as the root Caddyfile applies if you put this
# behind a Cloudflare Tunnel; swap the block below for a real domain
# (Caddy will provision/renew TLS automatically) if exposing it directly
# instead.
:80 {
	reverse_proxy mtg-judge:8000
}
